{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "right": 3
        }
    },

    "display": {
        "separator": "  ",
        "brightColor": true,
        "key": {
            "width": 6
        },
        "bar": {
            "width": 10,
            "char": {
                "elapsed": "━",
                "total": "─"
            }
        },
        "percent": {
            "type": 3,
            "ndigits": 0
        }
    },

    "modules": [
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
        },
        "separator",

        {
            "type": "os",
            "key": "╭─ {icon}",
            "keyColor": "magenta"
        },
        {
            "type": "host",
            "key": "├─ 󰌢",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "├─ ",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": "├─ 󰅐",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "╰─ 󰏖",
            "keyColor": "magenta"
        },

        "break",

        {
            "type": "wm",
            "key": "╭─ ",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": "├─ ",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key": "├─ ",
            "keyColor": "cyan"
        },
        {
            "type": "display",
            "key": "╰─ 󰍹",
            "keyColor": "cyan",
            "compactType": "original-with-refresh-rate"
        },

        "break",

        {
            "type": "cpu",
            "key": "╭─ 󰻠",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "├─ 󰍛",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key": "├─ 󰑭",
            "keyColor": "yellow"
        },
        {
            "type": "disk",
            "key": "├─ ",
            "keyColor": "yellow"
        },
        {
            "type": "battery",
            "key": "╰─ ",
            "keyColor": "yellow"
        },

        "break",
        {
            "type": "colors",
            "paddingLeft": 1,
            "symbol": "circle"
        }
    ]
}
