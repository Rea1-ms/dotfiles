{{- $showBattery := true -}}
{{- $hostIcon := "󰌢" -}}
{{- $logoType := "small" -}}
{{- if eq .chezmoi.os "windows" -}}
{{- $logoType = "builtin" -}}
{{- end -}}
{{- if eq .chezmoi.os "android" -}}
{{- $deviceClass := output "sh" "-c" "if getprop ro.build.characteristics 2>/dev/null | grep -qi tablet; then printf tablet; exit 0; fi; size=\"$(wm size 2>/dev/null | awk -F': ' '/size:/{value=$2} END{print value}')\"; density=\"$(wm density 2>/dev/null | awk '{value=$NF} END{print value}')\"; [ -n \"$density\" ] || density=\"$(getprop ro.sf.lcd_density 2>/dev/null)\"; if printf '%s' \"$size\" | grep -Eq '^[0-9]+x[0-9]+$' && printf '%s' \"$density\" | grep -Eq '^[0-9]+$'; then width=${size%x*}; height=${size#*x}; [ \"$width\" -le \"$height\" ] && short=$width || short=$height; [ $((short * 160 / density)) -ge 600 ] && printf tablet || printf phone; else printf phone; fi" -}}
{{- if eq $deviceClass "tablet" -}}
{{- $hostIcon = "󰓶" -}}
{{- else -}}
{{- $hostIcon = "󰄜" -}}
{{- end -}}
{{- $batteryProbe := output "sh" "-c" "if command -v termux-battery-status >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1 && timeout 2s termux-battery-status >/dev/null 2>&1; then printf yes; else printf no; fi" -}}
{{- $showBattery = eq $batteryProbe "yes" -}}
{{- end -}}
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "{{ $logoType }}",
        "padding": {
            "top": 1,
            "right": 3
        }
    },

    "display": {
        "separator": "  ",
        "brightColor": true,
        "key": {
            "width": 6
        },
        "bar": {
            "width": 10,
            "char": {
                "elapsed": "━",
                "total": "─"
            }
        },
        "percent": {
            "type": 3,
            "ndigits": 0
        }
    },

    "modules": [
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
        },
        "separator",

        {
            "type": "os",
            "key": "╭─ {icon}",
            "keyColor": "magenta"
        },
        {
            "type": "host",
            "key": "├─ {{ $hostIcon }}",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "├─ ",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": "├─ 󰅐",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "{{ if eq .chezmoi.os "windows" }}├─{{ else }}╰─{{ end }} 󰏖",
            "keyColor": "magenta"
        }{{ if eq .chezmoi.os "windows" }},
        {
            "type": "command",
            "key": "╰─ 󰏖",
            "keyColor": "magenta",
            "text": "pwsh -NoLogo -NoProfile -NonInteractive -File \"%USERPROFILE%/.config/fastfetch/winget-count.ps1\"",
            "format": "{result} (winget)"
        }{{ end }},

        "break",

        {
            "type": "wm",
            "key": "╭─ ",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": "├─ ",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key": "├─ ",
            "keyColor": "cyan"
        },
        {
            "type": "display",
            "key": "╰─ 󰍹",
            "keyColor": "cyan",
            "compactType": "original-with-refresh-rate"
        },

        "break",

        {
            "type": "cpu",
            "key": "╭─ 󰻠",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "├─ 󰍛",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key": "├─ 󰑭",
            "keyColor": "yellow"
        },
        {
            "type": "disk",
            "key": "├─ ",
            "keyColor": "yellow"
        },{{ if $showBattery }}
        {
            "type": "battery",
            "key": "╰─ ",
            "keyColor": "yellow"
        },{{ end }}

        "break",
        {
            "type": "colors",
            "paddingLeft": 1,
            "symbol": "circle"
        }
    ]
}
