{{ if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = "Stop"

if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Warning "没有找到 winget，请手动安装 PowerShell 7、Coreutils、Starship 和 Fastfetch。"
    exit 0
}

function Install-WingetPackage {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Id,
        [switch]$Force
    )

    $arguments = @(
        "install", "--id", $Id, "--exact", "--silent",
        "--accept-package-agreements", "--accept-source-agreements",
        "--disable-interactivity"
    )
    if ($Force) {
        $arguments += "--force"
    }

    & winget @arguments
    if ($LASTEXITCODE -ne 0) {
        throw "winget 安装 $Id 失败，退出代码：$LASTEXITCODE"
    }
}

function Find-Pwsh {
    $command = Get-Command pwsh -CommandType Application -ErrorAction SilentlyContinue
    if ($command) {
        return $command.Source
    }

    $defaultPath = Join-Path $env:ProgramFiles "PowerShell\7\pwsh.exe"
    if (Test-Path -LiteralPath $defaultPath -PathType Leaf) {
        return $defaultPath
    }

    return $null
}

function Get-PwshVersion {
    param([Parameter(Mandatory = $true)][string]$Path)

    try {
        $version = & $Path -NoLogo -NoProfile -NonInteractive -Command `
            '$PSVersionTable.PSVersion.ToString()'
        if ($LASTEXITCODE -eq 0) {
            return [version](($version -split "[-+]", 2)[0])
        }
    } catch {
        return $null
    }

    return $null
}

$minimumPwshVersion = [version]"7.4.0"
$pwshPath = Find-Pwsh
$pwshVersion = if ($pwshPath) { Get-PwshVersion -Path $pwshPath } else { $null }
if ($null -eq $pwshVersion -or $pwshVersion -lt $minimumPwshVersion) {
    Install-WingetPackage -Id "Microsoft.PowerShell"
    $pwshPath = Find-Pwsh
    $pwshVersion = if ($pwshPath) { Get-PwshVersion -Path $pwshPath } else { $null }
}

if ($pwshPath -and $pwshVersion -ge $minimumPwshVersion) {
    $pwshDirectory = Split-Path -Parent $pwshPath
    if (($env:Path -split ";") -notcontains $pwshDirectory) {
        $env:Path = "$pwshDirectory;$env:Path"
    }
} else {
    throw "Coreutils 需要 PowerShell 7.4 或更高版本，当前未找到可用版本。"
}

if (-not (Get-Command starship -ErrorAction SilentlyContinue)) {
    Install-WingetPackage -Id "Starship.Starship"
}

if (-not (Get-Command fastfetch -ErrorAction SilentlyContinue)) {
    Install-WingetPackage -Id "Fastfetch-cli.Fastfetch"
}

$coreutilsRoot = Join-Path $env:ProgramFiles "coreutils"
$coreutilsExecutable = Join-Path $coreutilsRoot "coreutils.exe"
$coreutilsInstaller = Join-Path $coreutilsRoot "pwsh-install.ps1"
$coreutilsCmdDirectory = Join-Path $coreutilsRoot "cmd"
$coreutilsMarker = "60b36fc6-2d59-49df-be51-28dd2f4c3c9a"
$pwshProfilePath = Join-Path ([Environment]::GetFolderPath("MyDocuments")) "PowerShell\Microsoft.PowerShell_profile.ps1"

function Get-CoreutilsMarkerCount {
    if (-not (Test-Path -LiteralPath $pwshProfilePath -PathType Leaf)) {
        return 0
    }

    return ([regex]::Matches(
        (Get-Content -LiteralPath $pwshProfilePath -Raw),
        [regex]::Escape($coreutilsMarker)
    )).Count
}

$markerCount = Get-CoreutilsMarkerCount
if (-not (Test-Path -LiteralPath $coreutilsExecutable -PathType Leaf)) {
    Install-WingetPackage -Id "Microsoft.Coreutils"
} elseif ($markerCount -eq 0) {
    # 重新运行官方安装器，让它为当前用户生成 PowerShell 集成段。
    Install-WingetPackage -Id "Microsoft.Coreutils" -Force
} elseif ($markerCount -ne 2) {
    throw "PowerShell profile 中的 Coreutils 标记不完整，请先手动修复：$pwshProfilePath"
}

if (-not (Test-Path -LiteralPath $coreutilsInstaller -PathType Leaf)) {
    throw "Coreutils 安装完成后仍未找到集成脚本：$coreutilsInstaller"
}

$markerCount = Get-CoreutilsMarkerCount
if ($markerCount -ne 2) {
    throw "Coreutils 安装器没有生成完整的 PowerShell 集成段：$pwshProfilePath"
}

& $pwshPath -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass `
    -File $coreutilsInstaller -Action Refresh -CmdDir $coreutilsCmdDirectory
if ($LASTEXITCODE -ne 0) {
    throw "刷新 Coreutils PowerShell 集成失败，退出代码：$LASTEXITCODE"
}
{{ end -}}
